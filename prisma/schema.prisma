generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum ProblemStatus { DRAFT PUBLISHED OPEN CLOSED EXPIRED ARCHIVED SOURCE_UNAVAILABLE }
enum AttemptStatus { PLANNED CLAIMED BUILDING TESTING SUBMITTED CHANGES_REQUESTED COMPLETED PAUSED ABANDONED }
enum ReviewStatus { UNREVIEWED PENDING ACCEPTED REJECTED CHANGES_REQUESTED }
enum ImpactStatus { NOT_SUBMITTED EVIDENCE_SUBMITTED UNDER_REVIEW CONFIRMED CHANGES_REQUESTED }
enum Visibility { PRIVATE TEAM PUBLIC }
enum EvidenceAccess { PRIVATE REVIEWERS TEAM PUBLIC }
enum MilestoneStatus { TODO IN_PROGRESS DONE }
enum UserRole { MEMBER REVIEWER ADMIN }

model User { id String @id @default(cuid()); email String @unique; displayName String; skills String; profile String?; role UserRole @default(MEMBER); visibility Visibility @default(PRIVATE); createdAt DateTime @default(now()); accounts Account[]; sessions Session[]; saves Save[]; attempts ProblemAttempt[]; auditEvents AuditEvent[]; reviews Review[] }
model Account { userId String; type String; provider String; providerAccountId String; refresh_token String? @db.Text; access_token String? @db.Text; expires_at Int?; token_type String?; scope String?; id_token String? @db.Text; session_state String?; user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@id([provider, providerAccountId]) }
model Session { sessionToken String @unique; userId String; expires DateTime; user User @relation(fields: [userId], references: [id], onDelete: Cascade) }
model VerificationToken { identifier String; token String @unique; expires DateTime; @@unique([identifier, token]) }
model ProblemStatement { id String @id @default(cuid()); title String; description String; organization String; sourceName String; sourceUrl String?; domain String; technologies String; deadline DateTime?; eligibility String?; status ProblemStatus @default(OPEN); lastCheckedAt DateTime @default(now()); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; attempts ProblemAttempt[]; saves Save[]; auditEvents AuditEvent[] }
model Save { userId String; problemId String; createdAt DateTime @default(now()); user User @relation(fields: [userId], references: [id], onDelete: Cascade); problem ProblemStatement @relation(fields: [problemId], references: [id], onDelete: Cascade); @@id([userId, problemId]) }
model ProblemAttempt { id String @id @default(cuid()); problemId String; userId String; status AttemptStatus @default(PLANNED); reviewStatus ReviewStatus @default(UNREVIEWED); impactStatus ImpactStatus @default(NOT_SUBMITTED); visibility Visibility @default(PRIVATE); plan String?; repositoryUrl String?; demoUrl String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; problem ProblemStatement @relation(fields: [problemId], references: [id]); user User @relation(fields: [userId], references: [id]); milestones Milestone[]; submissions SolutionSubmission[]; evidence Evidence[]; impactClaims ImpactClaim[]; auditEvents AuditEvent[] }
model Milestone { id String @id @default(cuid()); attemptId String; title String; owner String?; dueDate DateTime?; status MilestoneStatus @default(TODO); notes String?; createdAt DateTime @default(now()); attempt ProblemAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade) }
model SolutionSubmission { id String @id @default(cuid()); attemptId String; version Int; description String; requirementsMapping String; repositoryUrl String?; demoUrl String?; evidence String; limitations String?; createdAt DateTime @default(now()); attempt ProblemAttempt @relation(fields: [attemptId], references: [id]); reviews Review[]; evidenceItems Evidence[] }
model Evidence { id String @id @default(cuid()); attemptId String; submissionId String?; type String; url String?; description String; access EvidenceAccess @default(PRIVATE); createdAt DateTime @default(now()); attempt ProblemAttempt @relation(fields: [attemptId], references: [id]); submission SolutionSubmission? @relation(fields: [submissionId], references: [id]) }
model Review { id String @id @default(cuid()); submissionId String; reviewerId String; decision ReviewStatus; criteria String; notes String; createdAt DateTime @default(now()); submission SolutionSubmission @relation(fields: [submissionId], references: [id]); reviewer User @relation(fields: [reviewerId], references: [id]) }
model ImpactClaim { id String @id @default(cuid()); attemptId String; metric String; value String; unit String; period String; method String; evidence String; status ImpactStatus @default(NOT_SUBMITTED); verificationLevel String @default("Unreviewed"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; attempt ProblemAttempt @relation(fields: [attemptId], references: [id]) }
model AuditEvent { id String @id @default(cuid()); actorId String; problemId String?; attemptId String?; action String; priorState String?; newState String?; reason String?; createdAt DateTime @default(now()); actor User @relation(fields: [actorId], references: [id]); problem ProblemStatement? @relation(fields: [problemId], references: [id]); attempt ProblemAttempt? @relation(fields: [attemptId], references: [id]) }
